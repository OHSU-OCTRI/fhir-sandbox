{{>layout/header}}
<div class="container">
    <h1>{{entityName}}</h1>
    {{>components/messages}}
    <div>
        {{#entity}}
        <h5>{{#i18n}}smartClient.sandbox.label{{/i18n}}</h5>
        <p>
            {{#sandbox}}{{label}}{{/sandbox}}
            {{^sandbox}}<span class="text-muted">{{#i18n}}system.entity.none{{/i18n}}</span>{{/sandbox}}
        </p>
        <h5>{{#i18n}}smartClient.clientType.label{{/i18n}}</h5>
        <p>
            {{#clientType}}{{.}}{{/clientType}}
            {{^clientType}}<span class="text-muted">{{#i18n}}system.entity.none{{/i18n}}</span>{{/clientType}}
        </p>
        <h5>{{#i18n}}smartClient.clientId.label{{/i18n}}</h5>
        <p>
            {{#clientId}}{{.}}{{/clientId}}
            {{^clientId}}<span class="text-muted">{{#i18n}}system.entity.none{{/i18n}}</span>{{/clientId}}
        </p>
        <h5>{{#i18n}}smartClient.description.label{{/i18n}}</h5>
        <p>
            {{#description}}{{.}}{{/description}}
            {{^description}}<span class="text-muted">{{#i18n}}system.entity.none{{/i18n}}</span>{{/description}}
        </p>
        <h5>{{#i18n}}smartClient.launchUri.label{{/i18n}}</h5>
        <p>
            {{#launchUri}}{{.}}{{/launchUri}}
            {{^launchUri}}<span class="text-muted">{{#i18n}}system.entity.none{{/i18n}}</span>{{/launchUri}}
        </p>
        <h5>{{#i18n}}smartClient.redirectUris.label{{/i18n}}</h5>
        <p>
            {{#redirectUris}}{{.}}{{/redirectUris}}
            {{^redirectUris}}<span class="text-muted">{{#i18n}}system.entity.none{{/i18n}}</span>{{/redirectUris}}
        </p>
        <h5>{{#i18n}}smartClient.scopes.label{{/i18n}}</h5>
        <p>
            {{#scopes}}{{.}}{{/scopes}}
            {{^scopes}}<span class="text-muted">{{#i18n}}system.entity.none{{/i18n}}</span>{{/scopes}}
        </p>
        {{>components/show_links}}
        {{/entity}}
    </div>
</div>
{{>layout/footer}}