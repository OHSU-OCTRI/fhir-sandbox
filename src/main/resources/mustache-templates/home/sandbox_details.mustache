{{>layout/header}}
<div class="container">
	<h1>{{#entity}}{{label}}{{/entity}}</h1>
	{{>components/messages}}
	<div>
		{{#entity}}
		<h5>{{#i18n}}sandbox.owner.label{{/i18n}}</h5>
		<p>
			{{#owner}}{{label}}{{/owner}}
			{{^owner}}<span class="text-muted">{{#i18n}}system.entity.none{{/i18n}}</span>{{/owner}}
		</p>
		<h5>{{#i18n}}sandbox.status.label{{/i18n}}</h5>
		<p>
			{{#status}}{{.}}{{/status}}
			{{^status}}<span class="text-muted">{{#i18n}}system.entity.none{{/i18n}}</span>{{/status}}
		</p>
		<h5>{{#i18n}}sandbox.fhirServerUrl.label{{/i18n}}</h5>
		<p>
			{{#fhirServerUrl}}{{.}}{{>components/copy_field}}{{/fhirServerUrl}}
			{{^fhirServerUrl}}<span class="text-muted">{{#i18n}}system.entity.none{{/i18n}}</span>{{/fhirServerUrl}}
		</p>
		<h5>{{#i18n}}sandbox.accessToken.label{{/i18n}}</h5>
		<p>
			{{#accessToken}}{{>components/copy_field}}{{/accessToken}}
			{{^accessToken}}<span class="text-muted">{{#i18n}}system.entity.none{{/i18n}}</span>{{/accessToken}}
		</p>
		{{>components/show_links}}
		{{/entity}}
	</div>

	{{#entity.status.isReady}}
	<div class="vertical-space">
		<h2>Sandbox Sharing</h2>
		<div id="shared_users_selector" data-endpoint="{{req.contextPath}}{{baseRoute}}/{{entity.id}}/shared_users"></div>
	</div>

	<div class="vertical-space">
	<h2>{{#i18n}}sandbox.clients.label{{/i18n}}</h2>

	<p><a href="{{req.contextPath}}{{baseRoute}}/{{entity.id}}/client/new" class="btn btn-primary">{{#i18n}}smartClient.actions.new{{/i18n}}</a></p>

	{{#clients.0}}
	<table class="table table-striped table-bordered sorted">
		<thead>
			<tr>
				<th>{{#i18n}}smartClient.name.label{{/i18n}}</th>
				<th>{{#i18n}}smartClient.clientId.label{{/i18n}}</th>
				<th>{{#i18n}}smartClient.launchUri.label{{/i18n}}</th>
				<th>{{#i18n}}system.entity.actions{{/i18n}}</th>
			</tr>
		</thead>
		<tbody>
			{{#clients}}
			<tr>
				<td>{{name}}</td>
				<td>{{#clientId}}{{.}}{{>components/copy_field}}{{/clientId}}</td>
				<td>{{launchUri}}</td>
				<td>
					<a href="#" role="button" class="client-launch" data-client-id="{{clientId}}" data-launch-url="{{launchUri}}?iss={{fhirServerUrl}}">{{#i18n}}smartClient.actions.launch{{/i18n}}</a>
					<a href="{{req.contextPath}}{{baseRoute}}/{{sandbox.id}}/client/{{id}}/edit">{{#i18n}}system.entity.edit{{/i18n}}</a>
					<a href="{{req.contextPath}}{{baseRoute}}/{{sandbox.id}}/client/{{id}}/delete" class="text-danger" onclick="return confirm('{{#i18n}}smartClient.actions.deleteMessage{{/i18n}}');">{{#i18n}}system.entity.delete{{/i18n}}</a>
				</td>
			</tr>
			{{/clients}}
		</tbody>
	</table>

	<div id="launcher-app" data-sandbox-api="{{req.contextPath}}{{baseRoute}}/{{entity.id}}" data-sandbox-id="{{entity.serverPartitionName}}" data-fhir-api="{{fhirServerUrl}}" data-token="{{accessToken}}"></div>
	{{/clients.0}}
	{{^clients.0}}
	<p class="text-muted">{{#i18n}}sandbox.clients.none{{/i18n}}</p>
	{{/clients.0}}
	</div>
	{{/entity.status.isReady}}

	<div class="modal" tabindex="-1">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content launcher-modal-content">
				<div id="launcher-modal-body" class="modal-body d-flex flex-column gap-3">
				</div>
			</div>
		</div>
	</div>
</div>
{{>layout/footer}}