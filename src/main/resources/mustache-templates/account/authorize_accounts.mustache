<form name="updateSharedAccountsForm" class="invisble-form" method="POST" action="{{req.contextPath}}{{updateSharingAction}}" novalidate>
	{{ >authlib_fragments/forms/csrf_input }}
	<input id="add_sharing" class="form-control" type="hidden" name="addSharing[]" value="" />
	<input id="remove_sharing" class="form-control" type="hidden" name="removeSharing[]" value="" />
</form>

<h2>{{#i18n}}sandbox.sharingSelection.detailsSection.header{{/i18n}}</h2>
<div id="shared_accounts_selector" data-selected="{{selectedAccountsJson}}" data-available="{{availableAccountsJson}}">
  <div class="translation-wrapper" data-key="selectedHeader" data-value="{{#i18n}}sandbox.sharingSelection.selected.header{{/i18n}}"></div>
  <div class="translation-wrapper" data-key="availableHeader" data-value="{{#i18n}}sandbox.sharingSelection.available.header{{/i18n}}"></div>
  <div class="translation-wrapper" data-key="addSelectionButton" data-value="{{#i18n}}sandbox.sharingSelection.selectButton.label{{/i18n}}"></div>
  <div class="translation-wrapper" data-key="confirmModalHeader" data-value="{{#i18n}}sandbox.sharingSelection.confirmModal.header{{/i18n}}"></div>
  <div class="translation-wrapper" data-key="confirmAddedItemsHeader" data-value="{{#i18n}}sandbox.sharingSelection.confirmAddedItems.header{{/i18n}}"></div>
  <div class="translation-wrapper" data-key="confirmRemovedItemsHeader" data-value="{{#i18n}}sandbox.sharingSelection.confirmRemovedItems.header{{/i18n}}"></div>
</div>