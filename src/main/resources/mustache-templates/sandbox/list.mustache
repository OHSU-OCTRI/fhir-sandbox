{{>layout/header}}
<div class="container">
    <h1>{{entityName}} {{#i18n}}system.entity.list{{/i18n}}</h1>
    {{>components/messages}}
    <a href="{{req.contextPath}}{{baseRoute}}/new" class="new-entity btn btn-success"><i class="fas fa-plus-circle"></i> {{#i18n}}system.entity.new{{/i18n}}</a>
    <table class="table table-striped table-bordered sorted">
        <thead>
        <tr>
            <th>{{#i18n}}sandbox.owner.label{{/i18n}}</th>
            <th>{{#i18n}}sandbox.description.label{{/i18n}}</th>
            <th>{{#i18n}}sandbox.serverPartitionId.label{{/i18n}}</th>
            <th>{{#i18n}}sandbox.serverPartitionName.label{{/i18n}}</th>
            <th>{{#i18n}}system.entity.actions{{/i18n}}</th>
        </tr>
        </thead>
        <tbody>
        {{#entity_list}}
        <tr>
            <td>{{#owner}}{{label}}{{/owner}}</td>
            <td>{{#description}}{{.}}{{/description}}</td>
            <td>{{#serverPartitionId}}{{.}}{{/serverPartitionId}}</td>
            <td>{{#serverPartitionName}}{{.}}{{/serverPartitionName}}</td>
            <td>{{>components/list_actions}}</td>
        </tr>
        {{/entity_list}}
        </tbody>
    </table>
</div>
{{>layout/footer}}