{{>components/form_start}}
{{#entity}}
<div class="form-group">
    <label for="owner" class="form-label required-field">Owner</label>
    <select class="form-select" id="owner" name="owner" value="{{#owner}}{{.}}{{/owner}}" required>
        <option value="">-- Please Select --</option>
        {{#ownerOptions}}
        <option value="{{id}}" {{#selected}}selected{{/selected}}>{{label}}</option>
        {{/ownerOptions}}
    </select>
    <div class="invalid-feedback">Value must be present</div>
</div>

<div class="form-group">
    <label for="description" class="form-label required-field">Description</label>
    <input type="text" class="form-control" id="description" name="description" value="{{#description}}{{.}}{{/description}}" required maxlength="200">
    <div class="invalid-feedback">Value must be present and at most 200 characters</div>
</div>

<input type="hidden" id="server_partition_id" name="serverPartitionId" value="{{#serverPartitionId}}{{.}}{{/serverPartitionId}}" required>
<input type="hidden" id="server_partition_name" name="serverPartitionName" value="{{#serverPartitionName}}{{.}}{{/serverPartitionName}}" required>

{{/entity}}
{{>components/form_end}}