{{>components/form_start}}
{{#entity}}

<div class="form-group">
    <label for="locale" class="form-label required-field">{{#i18n}}translation.locale.label{{/i18n}}</label>
    <select class="form-select" id="locale" name="locale" value="{{#locale}}{{.}}{{/locale}}" required>
        <option value="">-- {{#i18n}}system.entity.select{{/i18n}} --</option>
        {{#supportedLocales}}
        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
        {{/supportedLocales}}
    </select>
    <div class="invalid-feedback">{{#i18n}}translation.locale.validationMessage{{/i18n}}</div>
</div>

<div class="form-group">
    <label for="messageKey" class="form-label required-field">{{#i18n}}translation.messageKey.label{{/i18n}}</label>
    <input type="text" class="form-control" id="messageKey" name="messageKey" value="{{#messageKey}}{{.}}{{/messageKey}}" required>
    <div class="invalid-feedback">{{#i18n}}translation.messageKey.validationMessage{{/i18n}}</div>
</div>

<div class="form-group">
    <label for="content" class="form-label">{{#i18n}}translation.content.label{{/i18n}}</label>
    <input type="text" class="form-control" id="content" name="content" value="{{#content}}{{.}}{{/content}}" >
</div>

<div class="form-group">
    <label for="description" class="form-label">{{#i18n}}translation.description.label{{/i18n}}</label>
    <input type="text" class="form-control" id="description" name="description" value="{{#description}}{{.}}{{/description}}" >
</div>

<div class="form-check">
    <input type="checkbox" class="form-check-input" id="markup_allowed" name="markupAllowed" value="1"  {{#markupAllowed}}checked{{/markupAllowed}}>
    <label for="markup_allowed" class="form-label">{{#i18n}}translation.markupAllowed.label{{/i18n}}</label>
</div>

{{/entity}}
{{>components/form_end}}