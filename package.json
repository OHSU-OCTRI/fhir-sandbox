{
    "name": "fhir-sandbox",
    "version": "1.0.0",
    "description": "User interface for OCTRI FHIR Sandbox",
    "main": "index.js",
    "scripts": {
        "build": "vue-tsc -b && vite build",
        "format": "prettier --no-error-on-unmatched-pattern --write ./*.js src/main/resources/**/*.{js,vue,spec.js}",
        "format:check": "prettier --no-error-on-unmatched-pattern --check ./*.js src/main/resources/**/*.{js,vue,spec.js}",
        "lint:js": "eslint --no-error-on-unmatched-pattern ./*.js src/main/resources/**/*.{ts,js,vue,spec.js}",
        "test": "vitest",
        "test:ci": "vitest run",
        "test:types": "vue-tsc -b"
    },
    "repository": {
        "type": "git",
        "url": "git@source.ohsu.edu:OCTRI-Apps/fhir-sandbox.git"
    },
    "author": "Oregon Clinical & Translational Research Institute (OCTRI) <octrihlp@ohsu.edu> (https://github.com/OCTRI)",
    "license": "BSD-2-Clause",
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^10.0.1",
        "@types/bootstrap": "^5.2.10",
        "@types/js-cookie": "^3.0.6",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vue/test-utils": "^2.4.9",
        "@vue/tsconfig": "^0.9.0",
        "eslint": "^10.3.0",
        "eslint-plugin-vue": "^10.9.0",
        "flush-promises": "^1.0.2",
        "globals": "^17.6.0",
        "jquery": "^3.5.1",
        "jsdom": "^29.1.1",
        "prettier": "^2.5.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.59.3",
        "vite": "^6.1.0",
        "vite-plugin-vuetify": "^2.1.3",
        "vitest": "^4.1.7",
        "vue-loader": "^17.0.0",
        "vue-tsc": "^3.2.5"
    },
    "dependencies": {
        "@mdi/font": "^7.4.47",
        "@tiptap/extension-color": "^2.10.4",
        "@tiptap/extension-image": "^2.10.4",
        "@tiptap/extension-link": "^2.10.4",
        "@tiptap/extension-table": "^2.10.4",
        "@tiptap/extension-table-cell": "^2.10.4",
        "@tiptap/extension-table-header": "^2.10.4",
        "@tiptap/extension-table-row": "^2.10.4",
        "@tiptap/extension-text-align": "^2.10.4",
        "@tiptap/starter-kit": "^2.10.4",
        "@tiptap/vue-3": "^2.10.4",
        "@vueuse/core": "^14.3.0",
        "bootstrap": "^5.3.8",
        "core-js": "^3.11.0",
        "dayjs": "^1.11.20",
        "js-cookie": "^3.0.5",
        "pinia": "^2.3.1",
        "vue": "^3.5.34",
        "vue-markdown-render": "^2.3.0",
        "vue-router": "^4.6.4",
        "vuetify": "^3.12.6"
    }
}
